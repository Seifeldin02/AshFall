    # Materials that may be airtagged.
    materials=[
        elytra,
        "totem_of_undying",
        trident,
        mace,
        shield,
        bow,
        crossbow,
        "fishing_rod",
        "enchanted_golden_apple",
        "nether_star"
    ]
}
