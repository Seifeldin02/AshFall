}
# Configure how Prism caches data. Probably best to leave
# these settings alone unless you have specific reasons to change them.
cache {
    # Enable stats recording. Ideally not used on live servers.
    record-stats=false
    # Cache settings for alerts.
    alerts {
        # Set a length of time (since last access) until entries are evicted.
        expires-after-access {
            # The duration value.
            duration=5
            # The duration time unit.
            time-unit=MINUTES
        }
        # The max size of this cache.
        # Data will be evicted if the cache size reaches this limit.
        max-size=1000
    }
    # Cache settings for alerted vein locations.
    alerted-locations {
        # Set a length of time (since last access) until entries are evicted.
        expires-after-access {
            # The duration value.
            duration=5
            # The duration time unit.
            time-unit=MINUTES
        }
        # The max size of this cache.
        # Data will be evicted if the cache size reaches this limit.
        max-size=1000
    }
    # Activity queries (lookups) are cached so that they can be re-used or paginated.
    lookup-expiration {
        # Set a length of time (since last access) until entries are evicted.
        expires-after-access {
            # The duration value.
            duration=5
            # The duration time unit.
            time-unit=MINUTES
        }
        # The max size of this cache.
        # Data will be evicted if the cache size reaches this limit.
        max-size=3
    }
    # Cache settings for default entity nbt data.
    nbt-entity-defaults {
        # Set a length of time (since last access) until entries are evicted.
        expires-after-access {
            # The duration value.
            duration=15
            # The duration time unit.
            time-unit=MINUTES
        }
        # The max size of this cache.
        # Data will be evicted if the cache size reaches this limit.
        max-size=200
    }
    # Cache settings for action key/primary keys.
    pk-cache-action-key {
        # The max size of this cache.
        # Data will be evicted if the cache size reaches this limit.
        max-size=100
    }
    # Cache settings for block data/primary keys.
    pk-cache-block-data {
        # Set a length of time (since last access) until entries are evicted.
        expires-after-access {
            # The duration value.
            duration=15
            # The duration time unit.
            time-unit=MINUTES
        }
        # The max size of this cache.
        # Data will be evicted if the cache size reaches this limit.
        max-size=500
    }
    # Cache settings for entity types/primary keys.
    pk-cache-entity-type {
        # The max size of this cache.
        # Data will be evicted if the cache size reaches this limit.
        max-size=200
    }
    # Cache settings for item data/primary keys.
    pk-cache-item-data {
        # Set a length of time (since last access) until entries are evicted.
        expires-after-access {
            # The duration value.
            duration=15
            # The duration time unit.
            time-unit=MINUTES
        }
        # The max size of this cache.
        # Data will be evicted if the cache size reaches this limit.
        max-size=1000
    }
    # Cache settings for named causes/primary keys.
    pk-cache-named-cause {
        # Set a length of time (since last access) until entries are evicted.
        expires-after-access {
            # The duration value.
            duration=15
            # The duration time unit.
            time-unit=MINUTES
        }
        # The max size of this cache.
        # Data will be evicted if the cache size reaches this limit.
        max-size=200
    }
    # Cache settings for players/primary keys.
    pk-cache-player {
        # Set a length of time (since last access) until entries are evicted.
        expires-after-access {
            # The duration value.
            duration=15
            # The duration time unit.
            time-unit=MINUTES
        }
        # The max size of this cache.
        # Data will be evicted if the cache size reaches this limit.
        max-size=100
    }
    # Cache settings for world/primary keys.
    pk-cache-world {
        # The max size of this cache.
        # Data will be evicted if the cache size reaches this limit.
        max-size=20
    }
}
commands {
    # Allow Minecraft tags in tag parameters. The list is long and often
    # includes tags unlikely to be useful. We instead recommend using
    # the tag whitelist option to reduce the list to something useful.
    # Note: disabling this overrides the tag whitelist.
    allow-minecraft-tags=true
    # Enable the block tag whitelist. If disabled, values will be ignored.
    block-tag-whitelist-enabled=false
    # Define block tags allowed in the btag parameter (and auto-suggestions).
    # These must include the tag namespace, e.g. `minecraft:dirt`, but can
    # include any tag - even custom ones.
    # https://minecraft.wiki/w/Block_tag_(Java_Edition)
    # Note: All Minecraft tags will be excluded if `allowMinecraftTags` is false.
    block-tag-whitelist=[
        "minecraft:coal_ores",
        "minecraft:copper_ores",
        "minecraft:crops",
        "minecraft:diamond_ores",
        "minecraft:emerald_ores",
