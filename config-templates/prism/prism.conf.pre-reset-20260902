# Actions are in-game events/changes that Prism can record data for.
# Some are purely informational, some can be reversed/restored.
# Disabling any here will completely prevent prism from recording them.
# Actions that are disabled by default may need some consideration/filters
# before enabling them. Blanket-enabling everything is a recipe for
# exponential database growth.
actions {
    # bed-enter is when a player or entity gets into bed.
    bed-enter=false
    # block-break is when a player or entity destroys a block (except from burn/explode).
    block-break=true
    # block-fade is when a block fades - melting snow, etc.
    block-fade=false
    # block-form is when a block forms - concrete, snow, etc.
    block-form=true
    # block-harvest is when a player harvests a block without breaking it (sweet berries).
    block-harvest=true
    # block-ignite is when a block is lit on fire.
    # Note: Fire spreads to other blocks (block-spread). This records an initial ignition.
    block-ignite=false
    # block-place is when a player or entity places a block.
    block-place=true
    # block-shift is when a piston pushes or pulls a block.
    # It's disabled by default because these are difficult to rollback
    # and can become extremely spammy due to redstone contraptions.
    # It WILL record dragon egg breaks even if block-shift is disabled.
    block-shift=false
    # block-spread is when a block spreads to a new block. Fire, mushrooms, etc.
    # This event can produce a lot of data. There's a lot of natural gen you may
    # wish to ignore. For example, vine/cave_vines all produce spread events
    # as they grow, and grass blocks as it's spreads to dirt.
    # A filter to ignore those is strongly recommended if you enable this.
    block-spread=false
    # block-use is when a player uses a block (buttons, doors, anvil, enchanting table, etc).
    block-use=true
    # bonemeal-use is when a player uses bonemeal on a block (grown trees/grass/flowers are block-place).
    bonemeal-use=false
    # bucket-empty is when a player places a block by emptying a bucket.
    bucket-empty=true
    # bucket-fill is when a player removes a block by filling a bucket.
    bucket-fill=true
    # entity-death is when a non-player entity dies.
    entity-death=true
    # entity-dye is when a player dyes an entity.
    entity-dye=false
    # entity-eat is when an entity eats a block and changes it.
    entity-eat=false
    # entity-leash is when a player leashes an entity.
    entity-leash=false
    # entity-place is when a player places an armor stand or end crystal.
    entity-place=true
    # entity-remove is when a player collects an entity, like fish with a water bucket.
    entity-remove=true
    # entity-rename is when a player renames an entity using a nametag.
    entity-rename=true
    # entity-ride is when a player rides an entity.
    entity-ride=false
    # entity-shear is when a player shears an entity.
    entity-shear=false
    # entity-transform is for villager healing, tadpoles to frogs, etc.
    entity-transform=false
    # entity-unleash is when a player or natural cause unleashes an entity.
    entity-unleash=true
    # firework-launch is when a player launches a firework rocket.
    firework-launch=false
    # fluid-flow tracks the flow of water and lava. Even when this is false,
    # prism will record blocks broken by either.
    # We very strongly recommend leaving this false and using
    # a drain command instead. This produces an insane amount of activity data.
    fluid-flow=false
    # hanging-break is when an item frame or painting is broken/detached.
    # This event will operate if block-break is false, even for detachments.
    hanging-break=true
    # hanging-place is when an item frame or painting is hung up.
    hanging-place=true
    # hopper-insert is when a hopper inserts an item into an inventory.
    # This event is aggregated. See the docs for more details.
    # If NOT using event aggregation, these can become massive database spam from farms.
    # We *strongly* recommend using robust inventory/land protection plugins instead.
    hopper-insert=false
    # hopper-remove is when a hopper removes an item from an inventory.
    # This event is aggregated. See the docs for more details.
    # If NOT using event aggregation, these can become massive database spam from farms.
    # We *strongly* recommend using robust inventory/land protection plugins instead.
    hopper-remove=false
    # inventory-open is when a player opens an inventory (chest, furnace, etc).
    # Item inserts or removes are tracked separately.
    inventory-open=false
    # item-despawn is when an item entity naturally despawns from age (5 minutes by default).
    # Note: this toggle currently has no effect. Only airtagged items are logged for this event,
    # and they are always logged. Full toggle support will be implemented in the future.
    item-despawn=false
    # item-destroy is when an item entity is destroyed by the environment - lava, fire,
    # cactus, the void, or an explosion.
    # Note: this toggle currently has no effect. Only airtagged items are logged for this event,
    # and they are always logged. Full toggle support will be implemented in the future.
    item-destroy=true
    # item-dispense is when a block dispenses an item.
    # This event is aggregated. See the docs for more details.
    item-dispense=true
    # item-drop is when a player or block drops an item on the ground.
    item-drop=true
    # item-insert is when a player or block inserts an item into an inventory.
    item-insert=true
    # item-pickup is when a player or entity picks up an item from the ground.
    item-pickup=true
    # item-remove is when a player or block removes an item from an inventory.
    item-remove=true
    # item-rotate is when a player rotates an item inside an item frame.
    item-rotate=false
    # item-throw is when a player throws an item.
    item-throw=true
    # item-trade is when a player trades with a villager or wandering trader.
    item-trade=true
    # item-use is when a player uses an item.
    item-use=true
    # player-chat is when a player tries to submit a chat message.
    player-chat=false
    # player-command is when a player tries to use a command.
    player-command=false
    # player-death is when a player dies.
    player-death=true
    # player-join is when a player connects to the server.
    player-join=false
    # player-quit is when a player disconnects from the server.
    player-quit=false
    # player-teleport is when a player teleports.
    player-teleport=false
    # raid-trigger is when a player triggers a raid.
    raid-trigger=true
    # sign-edit is when a player edits the text on a sign.
    sign-edit=true
    # vehicle-break is when something breaks a boat or minecart.
    vehicle-break=true
    # vehicle-exit is when an entity exits a boat or minecart.
    vehicle-exit=true
    # vehicle-place is when a player places a boat or minecart.
    vehicle-place=true
    # vehicle-ride is when an entity enters a boat or minecart.
    vehicle-ride=true
    # worldedit-break is when a block is removed via WorldEdit.
    # Requires WorldEdit to be installed.
    worldedit-break=false
    # worldedit-place is when a block is placed via WorldEdit.
    # Requires WorldEdit to be installed.
    worldedit-place=false
    # xp-pickup is when a player picks up XP orbs.
    xp-pickup=false
}
# Activities represent an action, location, cause, timestamp, etc.
activities {
    # Whether to ignore recording activities for players in creative.
    # For finer control, you may also create a filter.
    ignore-creative=false
    # Commands that may contain sensitive data when tracking player-command.
    # Matches the beginning of a command string. Do not include the forward-slash.
    sensitive-commands=[
        l,
        login,
        reg,
        register,
        changepassword,
        changepw,
        unreg,
        unregister
    ]
    # Pattern used to format absolute timestamps shown in lookup results.
    # Follows the java.time.format.DateTimeFormatter pattern syntax.
    # Rendered in the server's local time zone.
    timestamp-format="yyyy-MM-dd HH:mm:ss"
}
# Restrict which items players are allowed to airtag.
airtags {
    # The number of airtags a player may own when they have no prism.command.airtags.limit.<n>
    # permission node. Set to -1 for unlimited.
    default-limit=-1
    # Item tags whose members may be airtagged.
    tags=[
        "minecraft:swords",
        "minecraft:axes",
        "minecraft:pickaxes",
        "minecraft:shovels",
        "minecraft:hoes",
        "minecraft:head_armor",
        "minecraft:chest_armor",
        "minecraft:leg_armor",
        "minecraft:foot_armor"
