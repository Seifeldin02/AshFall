<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>net.communitysmp</groupId>
  <artifactId>smpcore</artifactId>
    <version>1.7.0</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
  </repositories>
  <dependencies>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>26.2.build.65-beta</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>net.milkbowl.vault</groupId>
      <artifactId>VaultUnlocked</artifactId>
      <version>2.20.2</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/../plugins/VaultUnlocked-2.20.2.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>fr.xephi</groupId>
      <artifactId>AuthMe</artifactId>
      <version>6.0.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/../plugins/AuthMe-6.0.0-Paper.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.49.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.github.NEZNAMY</groupId>
      <artifactId>TAB-API</artifactId>
      <version>6.1.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/../staging/tab-elites-20260723/TAB.v6.1.0.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>ac.grim</groupId>
      <artifactId>grimac-bukkit</artifactId>
      <version>2.3.74</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/../plugins/grimac-bukkit-2.3.74-85dd3d9.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.geysermc.geyser</groupId>
      <artifactId>api</artifactId>
      <version>2.11.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/../plugins/Geyser-Spigot.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>uk.co.forgevector</groupId>
      <artifactId>replaycore</artifactId>
      <version>1.5.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/../plugins/ReplayCore-1.5.0.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.lishid</groupId>
      <artifactId>openinv</artifactId>
      <version>5.3.3</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/../plugins/OpenInv.jar</systemPath>
    </dependency>
  </dependencies>
  <build>
        <finalName>SMPCore-1.7.0</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet><includes><include>org.xerial:sqlite-jdbc</include></includes></artifactSet>
              <filters>
                <filter>
                  <artifact>org.xerial:sqlite-jdbc</artifact>
                  <excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.RSA</exclude></excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
