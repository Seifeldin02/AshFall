<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>net.communitysmp</groupId>
  <artifactId>smpcore</artifactId>
    <version>1.7.0</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <repositories>
        <!-- PacketEvents is not published to Paper's repo; CodeMC is its official host. -->
        <repository>
            <id>codemc</id>
            <url>https://repo.codemc.io/repository/maven-releases/</url>
        </repository>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
  </repositories>
  <dependencies>
        <!-- Provided: the shaded packetevents plugin supplies these classes at runtime, so they must NOT
             be bundled into our jar (double-loading packet handlers would be a real problem). -->
        <dependency>
            <groupId>com.github.retrooper</groupId>
            <artifactId>packetevents-spigot</artifactId>
            <version>2.13.0</version>
            <scope>provided</scope>
            <!-- PacketEvents ships its own older Adventure. On the compile classpath it shadows the newer
                 copy Paper provides and breaks unrelated classes using current Adventure APIs, so it is
                 excluded here. At runtime Paper's Adventure is the one actually present. -->
            <exclusions>
                <exclusion><groupId>net.kyori</groupId><artifactId>*</artifactId></exclusion>
            </exclusions>
        </dependency>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>26.2.build.65-beta</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>net.milkbowl.vault</groupId>
      <artifactId>VaultUnlocked</artifactId>
      <version>2.20.2</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/../plugins/VaultUnlocked-2.20.2.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>fr.xephi</groupId>
      <artifactId>AuthMe</artifactId>
      <version>6.0.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/../plugins/AuthMe-6.0.0-Paper.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.49.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.github.NEZNAMY</groupId>
      <artifactId>TAB-API</artifactId>
      <version>6.1.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/../staging/tab-elites-20260723/TAB.v6.1.0.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>ac.grim</groupId>
      <artifactId>grimac-bukkit</artifactId>
      <version>2.3.74</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/../plugins/grimac-bukkit-2.3.74-85dd3d9.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.geysermc.geyser</groupId>
      <artifactId>api</artifactId>
      <version>2.11.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/../plugins/Geyser-Spigot.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>uk.co.forgevector</groupId>
      <artifactId>replaycore</artifactId>
      <version>1.5.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/../plugins/ReplayCore-1.5.0.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.lishid</groupId>
      <artifactId>openinv</artifactId>
      <version>5.3.3</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/../plugins/OpenInv.jar</systemPath>
    </dependency>
    <!-- WorldEdit isn't installed on production yet (staging-only for now), so unlike the other
         system-scoped jars above, build.ps1 does not re-stage this one from $SourceServer on every
         build; it was copied into ../plugins/ once, manually, from staging. -->
    <dependency>
      <groupId>com.sk89q.worldedit</groupId>
      <artifactId>worldedit-bukkit</artifactId>
      <version>7.4.4</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/../plugins/worldedit-bukkit-7.4.4.jar</systemPath>
    </dependency>
  </dependencies>
  <build>
        <finalName>SMPCore-1.7.0</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet><includes><include>org.xerial:sqlite-jdbc</include></includes></artifactSet>
              <filters>
                <filter>
                  <artifact>org.xerial:sqlite-jdbc</artifact>
                  <excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.RSA</exclude></excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
